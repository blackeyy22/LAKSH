NODE_ENV=development
PORT=3000
APP_NAME=Laksh
COMPANY_NAME=Laksh
SESSION_DAYS=7

# Admin seed account
ADMIN_EMAIL=#########
ADMIN_PASSWORD=##########

# Company email sender
# The app uses these to send OTPs and account/payment/referral notifications.
COMPANY_EMAIL=################
COMPANY_EMAIL_PASSWORD=#############
COMPANY_EMAIL_NAME=######

# SMTP provider details
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Payment / WhatsApp configuration
PAYMENT_UPI_ID=###############
# Optional absolute URL to a payment QR image instead of generating from PAYMENT_UPI_ID
PAYMENT_QR_IMAGE=/assets/images/payment2.jpeg
WHATSAPP_NUMBER=#################
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your-group-invite
